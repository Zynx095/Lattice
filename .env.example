# --- Spotify app credentials (from developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
# Spotify requires 127.0.0.1 (not "localhost") for local http redirects.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Space-separated scopes. Trim to what you actually need.
SPOTIFY_SCOPES=user-read-private user-read-email user-top-read user-read-recently-played playlist-read-private playlist-modify-public playlist-modify-private user-read-playback-state user-modify-playback-state user-read-currently-playing

# --- Spotify endpoints (rarely change) ---
SPOTIFY_AUTH_URL=https://accounts.spotify.com/authorize
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_API_BASE_URL=https://api.spotify.com/v1

# --- AI assistant: Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Cheap/fast model for short answers, stronger model for long/complex ones
CLAUDE_MODEL_LIGHT=claude-haiku-5-5
CLAUDE_MODEL_HEAVY=claude-sonnet-5-5

# --- AI assistant: Gemini (aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
# The server checks these names against each provider's live model list at startup
GEMINI_MODEL_LIGHT=gemini-3.8-flash
GEMINI_MODEL_HEAVY=gemini-3.1-pro-preview
# Comma-separated extra models tried when light/heavy hit their quota (each model has its own quota)
GEMINI_MODEL_BACKUP=gemini-3.5-flash,gemini-3.1-flash-lite

# --- AI routing: pick provider/model by tokens needed and usage ---
# Order tried first -> fallback (used on error, rate limit, or exhausted quota)
AI_PROVIDER_PRIORITY=claude,gemini
# Prompts estimated at or below this many input tokens go to the LIGHT model; above go to HEAVY
AI_LIGHT_MAX_INPUT_TOKENS=1500
# Cap on tokens generated per answer
AI_MAX_OUTPUT_TOKENS=1024
# Prompts larger than this go to Gemini (larger context window) regardless of priority
AI_GEMINI_ONLY_ABOVE_TOKENS=150000
# Usage limits (0 = unlimited). When a provider hits its daily cap, requests fall over to the other.
CLAUDE_DAILY_TOKEN_LIMIT=200000
GEMINI_DAILY_TOKEN_LIMIT=500000
# Per-user requests per minute to the assistant
AI_RATE_LIMIT_PER_MINUTE=20

# --- App settings ---
PORT=3000
# Express API port (the frontend calls http://localhost:3001/api)
SERVER_PORT=3001
# Per-provider request timeout
AI_TIMEOUT_MS=25000
NODE_ENV=development
# Random string used to sign sessions/cookies (generate your own long random value)
SESSION_SECRET=change_me_to_a_long_random_string
# Allowed browser origins for the API, comma-separated (empty = any)
CORS_ORIGIN=
